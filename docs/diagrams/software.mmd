flowchart LR
    STUDIO["studio/ · web page :8080<br/>artists' scenes, sounds, buttons"]
    subgraph IN["Inputs · spooky/hw"]
        direction TB
        CTL["control.py · :8070<br/>eyes / wake / reset / i.MX"]
        CAM["camera.py<br/>USB cam or photos"]
    end
    subgraph BG["Background threads"]
        direction TB
        FW["FaceWatcher<br/>YuNet faces"]
        EX["scare worker<br/>ScarySmile"]
    end
    subgraph CORE["Main loop · 50 Hz"]
        direction TB
        SHOW["show.py<br/>state machine"]
        VO["voices.py<br/>boss lines"]
        SCN["scenes.py<br/>effects.py"]
        LAY["layout.py<br/>map · gamma · current cap"]
    end
    subgraph OUT["Outputs · spooky/hw"]
        direction TB
        LEDS["teensy.py<br/>USB serial → Teensy → rings"]
        SND["outputs.py<br/>speaker"]
        DSP["display.py · :8090<br/>live camera, prompts, before/after"]
        IMX["imx.py<br/>UDP trigger → i.MX"]
    end

    CTL -- commands --> SHOW
    CAM --> FW -- faces --> SHOW
    SHOW <-- "photo / scary image" --> EX
    SHOW -- event --> VO
    SHOW -- state --> SCN
    VO -- "talking scene" --> SCN
    SCN -- frame --> LAY --> LEDS
    VO -- line --> SND
    SHOW -- "sound effect" --> SND
    SHOW -- "prompts / photos" --> DSP
    SHOW -- "animation per state" --> IMX
    FW -- "live frames" --> DSP
    STUDIO -. "custom_scenes.json" .-> SCN
    STUDIO -. "uploads → sounds/" .-> VO
    STUDIO -. "pretend visitor / face" .-> SHOW
