[Unit]
Description=spooky-pi Halloween show
Conflicts=spooky-studio.service
After=pipewire.service

[Service]
WorkingDirectory=%h/spooky
ExecStartPre=/bin/bash %h/spooky/scripts/wait-for-hardware.sh 45
TimeoutStartSec=90
ExecStart=%h/spooky/.venv/bin/python -m spooky
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
