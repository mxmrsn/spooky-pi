[Unit]
Description=Spooky Studio (artist web page on port 8080)
Conflicts=spooky-show.service
After=pipewire.service

[Service]
WorkingDirectory=%h/spooky
ExecStartPre=/bin/bash %h/spooky/scripts/pi/wait-for-hardware.sh 45
TimeoutStartSec=90
ExecStart=%h/spooky/.venv/bin/python -m spooky.studio --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
