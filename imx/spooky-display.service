[Unit]
Description=spooky-pi photo display (MJPEG stream from the Pi)
Wants=network-online.target
After=network-online.target weston.service

[Service]
# Weston on NXP Yocto images usually runs as root with these; check with: ls /run/user/*/wayland-*
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=WAYLAND_DISPLAY=wayland-1
Environment=SPOOKY_PI=192.168.77.1
# Environment=SPOOKY_SINK=kmssink   # uncomment if there's no Weston desktop
ExecStart=/usr/bin/spooky-display.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
